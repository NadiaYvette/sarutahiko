cabal-version:      3.14
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'sarutahiko' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               sarutahiko

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           AI assistance ecosystem
description:
    Sarutahiko is an AI assistance ecosystem reimplementing agent cores,
    protocols, code intelligence, and execution substrates on extensible records
    (large-anon), row-typed algebraic effects (effectful/polysemy), and streaming kernels (yamaarashi).
    .
    Conceptual Lineage and Attribution:
    Per DOC_STRATEGY.md §9 and NOTICE.md, Sarutahiko explicitly acknowledges its
    intellectual debts to the pioneering work of:
    * The Keiro ecosystem (Nadeem Bitar) — baikai, keiro, kiroku, shibuya, kioku, shikumi, keiki
    * Hermes Agent (Nous Research Inc.) — turn loops, tool registries, plugin security, hooks
    * large-records & large-anon (Edsko de Vries / Well-Typed) — extensible records bedrock
    * Selective Applicative Functors & Algebraic Graphs (Andrey Mokhov) — workflow DAGs
    * Streamly (Harendra Kumar) & Conduit (Michael Snoyman) — streaming architectures
    * Hasql (Nikita Volkov), Beam (Travis Whitaker), and Direct-SQLite — database abstractions
    * Effectful (Ertugrul Söylemez) & Polysemy (Sandy Maguire) — algebraic effect runtimes
    .
    See NOTICE.md and CREDITS.md at the repository root for full details.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Development
build-type:         Simple
extra-doc-files:
    CHANGELOG.md
    README.md
    NOTICE.md
    CREDITS.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common extensions
    default-language: GHC2021

common ghc-options
    ghc-options: -Wall -Widentities

common rts-options
    ghc-options: -rtsopts -threaded "-with-rtsopts=-N"

library
    -- Common language extensions
    import:           extensions

    -- Common compiler warnings and optimisations
    import:           ghc-options

    -- Modules exported by the library.
    exposed-modules:  MyLib

    -- Modules included in this library but not exported.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:    base >= 4.20 && < 5

    -- Directories containing source files.
    hs-source-dirs:   src

    -- Base language which the package is written in.
    default-language: Haskell2010

executable sarutahiko
    -- Common language extensions
    import:           extensions

    -- Common compiler warnings and optimisations
    import:           ghc-options

    -- Common RTS options
    import:           rts-options

    -- .hs or .lhs file containing the Main module.
    main-is:          Main.hs

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- Other library packages from which modules are imported.
    build-depends:
        base >= 4.20 && < 5,
        sarutahiko

    -- Directories containing source files.
    hs-source-dirs:   app

    -- Base language which the package is written in.
    default-language: Haskell2010

test-suite sarutahiko-test
    -- Common language extensions
    import:           extensions

    -- Common compiler warnings and optimisations
    import:           ghc-options

    -- Common RTS options
    import:           rts-options

    -- Base language which the package is written in.
    default-language: Haskell2010

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:

    -- The interface type and version of the test suite.
    type:             exitcode-stdio-1.0

    -- Directories containing source files.
    hs-source-dirs:   test

    -- The entrypoint to the test suite.
    main-is:          Main.hs

    -- Test dependencies.
    build-depends:
        base >= 4.20 && < 5,
        sarutahiko
