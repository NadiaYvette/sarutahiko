cabal-version:      3.14
name:               hashigakari-sqlite
version:            0.1.0.0
synopsis:           Embedded SQLite carrier for event store, task queue, and existential row steppers
description:
    Embedded SQLite carrier providing existential row stepping, append-only
    event sourcing, and atomic transaction leases over extensible records and
    algebraic effects.
    .
    Conceptual Lineage and Attribution:
    This package synthesizes database and streaming principles pioneered by:
    * 'direct-sqlite' (Irene Knittel, Jan Snajder) & SQLite — low-level C FFI statement stepping
    * 'hasql' (Nikita Volkov) — applicative row decoding directly into strongly-typed structures
    * 'beam' (Travis Whitaker) — relational schema and query composition (see LICENSES/NOTICE-beam.txt)
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Database, Effects
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Hashigakari.Sqlite
        Hashigakari.Sqlite.Stepper
        Hashigakari.Sqlite.EventStore
        Hashigakari.Sqlite.TaskQueue
        Hashigakari.Sqlite.Capability
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        sarutahiko-records,
        sarutahiko-effect-signatures >= 0.1,
        sarutahiko-effect-effectful >= 0.1,
        yamaarashi,
        yamaarashi-flow
    hs-source-dirs:   src

test-suite test-hashigakari-sqlite
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        stm >= 2.5,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        sarutahiko-records,
        directory >= 1.3,
        filepath >= 1.4,
        sarutahiko-effect-signatures,
        sarutahiko-effect-effectful,
        sarutahiko-effect-testkit,
        yamaarashi,
        yamaarashi-flow,
        hashigakari-sqlite,
        tasty,
        hedgehog,
        tasty-hedgehog
