cabal-version:      3.14
name:               kogaki-wire
version:            0.1.0.0
synopsis:           Zero-bloat row-native JSON lexer, decoder, and SSE streaming parser
description:
    Zero-Aeson streaming JSON lexer, decoder, and Server-Sent Events (SSE) parser
    producing tokens and extensible records directly without intermediate nominal ASTs.
    .
    Conceptual Lineage and Attribution:
    While embodying the Zero-Aeson doctrine, this package synthesizes algorithms
    and scanning techniques pioneered by:
    * 'aeson' & 'attoparsec' (Bryan O'Sullivan et al.) — fast byte-level whitespace
      skipping, number scanning, and string tokenization
    * 'wai-extra' (Michael Snoyman) — Server-Sent Events chunk framing parser
    * 'mono-traversable' (Michael Snoyman) — NonNull guarantees on wire buffers
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Data, Parsing, Network
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Kogaki.Wire
        Kogaki.Wire.Json.Lexer
        Kogaki.Wire.Json.Decode
        Kogaki.Wire.SSE.Parser
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        vector >= 0.13,
        primitive >= 0.9,
        large-anon,
        kogaki-core,
        sarutahiko-fields,
        sarutahiko-records,
        mono-traversable >= 1.0.17
    hs-source-dirs:   src

test-suite test-kogaki-wire
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        vector >= 0.13,
        kogaki-wire,
        kogaki-core,
        sarutahiko-fields,
        sarutahiko-records,
        mono-traversable >= 1.0.17,
        large-anon
