cabal-version:      3.14
name:               hokora
version:            0.1.0.0
synopsis:           Phase 1.5 Hokora vertical slice proving the skinny spine protocol
description:
    Phase 1.5 Hokora vertical slice implementing an autonomous single-turn ReAct
    agent with SQLite event sourcing, session hydration, and in-process MCP tools.
    .
    Conceptual Lineage and Attribution:
    This package proves the skinny spine protocol, drawing architectural lineage from:
    * The Keiro ecosystem (Nadeem Bitar) — event-sourced replay and state machines
    * SQLite (Public Domain) — embedded transactional persistence
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, Effects, AI
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Hokora
        Hokora.Types
        Hokora.Turn
        Hokora.Reducer
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-schema,
        sarutahiko-effect-signatures,
        sarutahiko-mcp,
        sarutahiko-jsonrpc,
        hashigakari-sqlite,
        utai,
        yamaarashi,
        yamaarashi-flow,
        typed-process >= 0.2.11
    hs-source-dirs:   src

executable hokora-run
    import:           commons
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-schema,
        sarutahiko-effect-signatures,
        sarutahiko-mcp,
        sarutahiko-jsonrpc,
        hashigakari-sqlite,
        utai,
        hokora

test-suite test-hokora
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-schema,
        sarutahiko-effect-signatures,
        sarutahiko-mcp,
        sarutahiko-jsonrpc,
        hashigakari-sqlite,
        utai,
        hokora,
        tasty,
        hedgehog,
        tasty-hedgehog
