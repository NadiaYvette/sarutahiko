cabal-version:      3.14
name:               sarutahiko-plugins
version:            0.1.0.0
synopsis:           Plugin manifest loader, capability grants, and kill-lists for the Sarutahiko agent ecosystem
description:
    Safe plugin discovery, manifest validation against capability allowlists,
    and kill-list enforcement at install and load time.
    .
    Conceptual Lineage and Attribution:
    This package adapts the plugin architecture and capability grant model of:
    * Hermes Agent (Nous Research) — plugin discovery, capability grants, and kill-lists
    .
    See NOTICE.md and LICENSES/NOTICE-hermes.txt at the repository root for
    complete intellectual provenance, conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, Security, AI
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Sarutahiko.Plugins
        Sarutahiko.Plugins.Types
        Sarutahiko.Plugins.Loader
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-mcp
    hs-source-dirs:   src

test-suite test-sarutahiko-plugins
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        sarutahiko-plugins,
        tasty,
        hedgehog,
        tasty-hedgehog
