cabal-version:      3.14
name:               sarutahiko-records
version:            0.1.0.0
synopsis:           Higher-kinded data (HKD), wire envelopes, and record combinators
description:
    Extensible record combinators, projection functions, wire envelopes, and
    TriState higher-kinded data (HKD) RFC 7396 merge patch semantics.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and synthesis of:
    * 'large-anon' (Edsko de Vries / Well-Typed) — $O(1)$ compile-time wide records
    * 'record-soup' & 'docrecords' (Yves Parès, Faura et al.) — record combinators
      and projection patterns
    * RFC 7396 (JSON Merge Patch) — TriState HKD update algebra
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Data, Records
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Sarutahiko.Records
        Sarutahiko.Records.HKD.TriState
        Sarutahiko.Records.Envelope
        Sarutahiko.Records.Combinators
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        vector >= 0.13,
        primitive >= 0.9,
        sarutahiko-fields >= 0.1,
        large-anon
    hs-source-dirs:   src

test-suite test
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Laws.CombinatorLaws
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        sarutahiko-fields,
        sarutahiko-records,
        large-anon

benchmark bench
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          CompileTime40Col.hs
    hs-source-dirs:   bench
    build-depends:
        base >= 4.20 && < 5,
        time >= 1.12,
        sarutahiko-records,
        large-anon
