cabal-version:      3.14
name:               sarutahiko-effect-polysemy
version:            0.1.0.0
synopsis:           Polysemy seam compatibility bridge for neutral signatures
description:
    Polysemy seam compatibility interpreters for Sarutahiko neutral effect
    signatures, providing dual-interpreter parity for downstream adopters.
    .
    Conceptual Lineage and Attribution:
    This package adapts and implements interpreters for Sandy Maguire's
    'polysemy' higher-order effect framework (BSD-3-Clause).
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, Effects
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Sarutahiko.Effect.Polysemy
        Sarutahiko.Effect.Interpreter.Polysemy
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        polysemy >= 1.9,
        sarutahiko-records, sarutahiko-process >= 0.1,
        sarutahiko-effect-signatures >= 0.1,
        sarutahiko-effect-effectful >= 0.1
    hs-source-dirs:   src
