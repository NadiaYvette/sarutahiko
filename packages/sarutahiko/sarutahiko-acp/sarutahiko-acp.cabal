cabal-version:      3.14
name:               sarutahiko-acp
version:            0.1.0.0
synopsis:           Agent Client Protocol (ACP) adapter over stdio for Zed and editor integration
description:
    Agent Client Protocol (ACP) adapter providing JSON-RPC 2.0 stdio framing,
    initialization handshake, session creation, prompt dispatch, and tool execution
    bridging editor clients to the Sarutahiko agent core.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and architectural synthesis of concepts
    pioneered by:
    * Agent Client Protocol (Zed Industries) — editor-agent JSON-RPC communication
    * Model Context Protocol (Anthropic) — capability negotiation and tool dispatch
    * Hermes Agent (Nous Research) — narrow-waist agent execution interfaces
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Development, Protocol, Editor, AI
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Sarutahiko.ACP
        Sarutahiko.ACP.Types
        Sarutahiko.ACP.Protocol
        Sarutahiko.ACP.Server
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-jsonrpc,
        mono-traversable >= 1.0.17,
        sarutahiko-agent
    hs-source-dirs:   src

test-suite test-sarutahiko-acp
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        sarutahiko-acp,
        sarutahiko-jsonrpc,
        tasty,
        hedgehog,
        tasty-hedgehog
