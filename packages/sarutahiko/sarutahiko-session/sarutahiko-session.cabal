cabal-version:      3.14
name:               sarutahiko-session
version:            0.1.0.0
synopsis:           Session persistence and conversation-tail reducer for the Sarutahiko agent ecosystem
description:
    Conversation persistence (utaibon), SQLite event-sourced message history,
    and tail compaction guaranteeing strict prompt-cache prefix preservation.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and synthesis of concepts pioneered by:
    * Hermes Agent session persistence (Nous Research) — state preservation and prompt-cache safety
    * 'shikumi' (Nadeem Bitar) — context window compaction algorithms (reserveTokens, compactTail)
    * 'keiki' (Nadeem Bitar) — pure event-sourcing transducers for session hydration
    .
    See NOTICE.md and LICENSES/NOTICE-hermes.txt at the repository root for
    complete intellectual provenance, conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, Effects, AI
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Sarutahiko.Session
        Sarutahiko.Session.Types
        Sarutahiko.Session.Reducer
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-effect-signatures,
        hashigakari-sqlite,
        utai
    hs-source-dirs:   src

test-suite test-sarutahiko-session
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-effect-signatures,
        hashigakari-sqlite,
        utai,
        sarutahiko-session,
        tasty,
        hedgehog,
        tasty-hedgehog
