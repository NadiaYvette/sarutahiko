cabal-version:      3.14
name:               sarutahiko-agent
version:            0.1.0.0
synopsis:           Full Hermes-style autonomous agent core (turn loop, tool registry, session persistence, hooks)
description:
    Autonomous agent core orchestrating bounded ReAct cognitive stepping,
    extensible record tool registries, session persistence, and subprocess hooks.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and architectural synthesis of concepts
    pioneered by:
    * Hermes Agent (Nous Research) — core turn loop, prompt-cache preservation,
      and narrow-waist tool execution architecture
    * ReAct paradigm (Shunyu Yao et al.) — interleaved Thought/Action/Observation cycles
    * The Keiro ecosystem (Nadeem Bitar) — foundational agent design patterns
    .
    See NOTICE.md and LICENSES/NOTICE-hermes.txt at the repository root for
    complete intellectual provenance, conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, AI, Agent
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Sarutahiko.Agent
        Sarutahiko.Agent.Registry
        Sarutahiko.Agent.Turn
        Sarutahiko.Agent.Loop
        Sarutahiko.Agent.Tools
        Sarutahiko.Agent.Live
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        directory >= 1.3,
        filepath >= 1.4,
        typed-process >= 0.2.11,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-schema,
        sarutahiko-effect-signatures,
        sarutahiko-process,
        sarutahiko-mcp,
        sarutahiko-session,
        sarutahiko-hooks,
        sarutahiko-plugins,
        hashigakari-sqlite,
        utai,
        yamaarashi-flow
    hs-source-dirs:   src

executable sarutahiko
    import:           commons
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        sarutahiko-effect-signatures,
        hashigakari-sqlite,
        utai,
        sarutahiko-session,
        sarutahiko-hooks,
        sarutahiko-plugins,
        sarutahiko-agent

test-suite test-sarutahiko-agent
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        directory >= 1.3,
        filepath >= 1.4,
        direct-sqlite >= 2.3,
        effectful-core >= 2.3,
        large-anon,
        sarutahiko-effect-signatures,
        hashigakari-sqlite,
        utai,
        sarutahiko-session,
        sarutahiko-hooks,
        sarutahiko-plugins,
        sarutahiko-agent,
        tasty,
        hedgehog,
        tasty-hedgehog
