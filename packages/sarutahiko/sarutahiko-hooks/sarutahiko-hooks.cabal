cabal-version:      3.14
name:               sarutahiko-hooks
version:            0.1.0.0
synopsis:           Shell-hook supervisor, consent allowlists, and safe execution for the Sarutahiko agent ecosystem
description:
    Subprocess hook supervisor with fail-closed sigKILL hard deadline enforcement,
    consent allowlists, and safe command execution across tool execution phases.
    .
    Conceptual Lineage and Attribution:
    This package adapts and refines the shell-hook architecture of:
    * Hermes Agent (Nous Research) — shell-hook conventions and consent allowlists
    * 'typed-process' (Michael Snoyman) — safe process supervision
    .
    See NOTICE.md and LICENSES/NOTICE-hermes.txt at the repository root for
    complete intellectual provenance, conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           System, Process, Security
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -Werror

library
    import:           commons
    exposed-modules:
        Sarutahiko.Hooks
        Sarutahiko.Hooks.Types
        Sarutahiko.Hooks.Allowlist
        Sarutahiko.Hooks.Supervisor
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        directory >= 1.3,
        filepath >= 1.4,
        typed-process >= 0.2.11,
        unix >= 2.8,
        stm >= 2.5,
        kogaki-core,
        kogaki-wire,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-process
    hs-source-dirs:   src

test-suite test-sarutahiko-hooks
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        containers >= 0.6,
        text >= 2.1,
        typed-process >= 0.2.11,
        sarutahiko-hooks,
        tasty,
        hedgehog,
        tasty-hedgehog
