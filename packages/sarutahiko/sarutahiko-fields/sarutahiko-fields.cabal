cabal-version:      3.14
name:               sarutahiko-fields
version:            0.1.0.0
synopsis:           First-class field datums and field registry
description:
    First-class singleton field definitions and registry shared across rows,
    providing single-point-of-truth field schemas for records and protocols.
    .
    Conceptual Lineage and Attribution:
    This package implements the "define a field exactly once" doctrine, synthesized from:
    * 'large-records' & 'large-anon' (Edsko de Vries / Well-Typed) — typelet field indexing
    * 'vinyl' (Anthony Cowley) — extensible universe-polymorphic field tagging
    * 'docrecords' (Yves Parès, Faura et al.) — field metadata and documentation binding
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Data, Records
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Sarutahiko.Fields
        Sarutahiko.Fields.Datum
        Sarutahiko.Fields.Witness
        Sarutahiko.Fields.Registry
    build-depends:
        base >= 4.20 && < 5,
        text >= 2.1,
        containers >= 0.6,
        kogaki-core >= 0.1
    hs-source-dirs:   src

test-suite test
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        text >= 2.1,
        containers >= 0.6,
        sarutahiko-fields
