cabal-version:       >=1.10
name:                sarutahiko-tracing
version:             0.1.0.0
synopsis:            Tracing effect wrapper for Sarutahiko
description:         Provides a MonadTracing effect signature and a Jaeger/OTLP exporter implementation.
license:             BSD3
license-file:        LICENSE
author:              Nadia Yvette
maintainer:          nyvette@example.com
category:            Development
build-type:          Simple
extra-source-files:  README.md

library
  exposed-modules:     Sarutahiko.Tracing
  hs-source-dirs:      src
  build-depends:       base >=4.17 && <5,
                       jaeger-client,
                       opentelemetry-collector,
                       bytestring,
                       text,
                       sarutahiko-observability
  default-language:    GHC2024
