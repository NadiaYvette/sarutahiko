cabal-version:      3.14
name:               kagami-ita-observability
version:            0.1.0.0
synopsis:           Kagami-Ita (鏡板) Observability and Token Accounting Substrate
description:
    Kagami-Ita (鏡板, the pine backdrop of the Noh stage) observability substrate
    for Sarutahiko: turn-level token accounting, prompt-cache efficiency tracking,
    context-inflation circuit breakers, and transcript ingestion.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Development, Observability
build-type:         Simple
extra-source-files: README.md

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:              commons
    exposed-modules:
        KagamiIta.Observability
        KagamiIta.Observability.KagamiIta
        KagamiIta.Observability.TokenLedger
        KagamiIta.Observability.Transcript
        Sarutahiko.Observability
        Sarutahiko.Observability.KagamiIta
        Sarutahiko.Observability.TokenLedger
        Sarutahiko.Observability.Transcript
    hs-source-dirs:      src
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        text >= 2.1,
        containers >= 0.6,
        time >= 1.12,
        aeson >= 2.2

test-suite test-kagami-ita-observability
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        text >= 2.1,
        containers >= 0.6,
        time >= 1.12,
        aeson >= 2.2,
        kagami-ita-observability,
        tasty,
        hedgehog,
        tasty-hedgehog,
        tasty-hunit
