cabal-version:      3.14
name:               yamaarashi-conduit
version:            0.1.0.0
synopsis:           Conduit boundary framing and process pipe adapters
description:
    Bidirectional streaming adapters bridging Yamaarashi existential Steppers
    and streams with ConduitT pipelines, supporting bracketed resource reclamation
    and line framing.
    .
    Conceptual Lineage and Attribution:
    This package bridges the Yamaarashi streaming kernel with Michael Snoyman's
    'conduit' streaming framework, acknowledging Conduit's pioneering bracketed
    resource cleanup model.
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Control, Streaming, Network
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Yamaarashi.Conduit
    build-depends:
        base >= 4.20 && < 5,
        bytestring >= 0.12,
        text >= 2.1,
        transformers >= 0.5,
        conduit >= 1.3,
        resourcet >= 1.3,
        sarutahiko-effect-signatures >= 0.1,
        yamaarashi
    hs-source-dirs:   src


