cabal-version:      3.14
name:               yamaarashi-spec
version:            0.1.0.0
synopsis:           Task specification AST, VirtualTree static over-approximation, and subdivision
description:
    Task specification AST, static resource over-approximation via Selective Over,
    and recursive subdivision of macroscopic project goals into atomic leaf task
    packets via fixed-point recursion schemes.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and synthesis of:
    * 'recursion-schemes' (Edward Kmett, Eric Mertens) — catamorphic AST folding
      and anamorphic/hylomorphic task subdivision
    * 'selective' (Andrey Mokhov et al.) — static dependency and resource over-approximation
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Development, Workflow
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Yamaarashi.Spec
        Yamaarashi.Spec.Types
        Yamaarashi.Spec.VirtualTree
        Yamaarashi.Spec.Subdivide
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        selective >= 0.5,
        recursion-schemes >= 5.2,
        sarutahiko-effect-signatures,
        yamaarashi
    hs-source-dirs:   src

test-suite yamaarashi-spec-test
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        selective >= 0.5,
        recursion-schemes >= 5.2,
        sarutahiko-effect-signatures,
        yamaarashi-spec,
        tasty,
        hedgehog,
        tasty-hedgehog

