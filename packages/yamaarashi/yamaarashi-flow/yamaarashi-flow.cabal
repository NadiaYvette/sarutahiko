cabal-version:      3.14
name:               yamaarashi-flow
version:            0.1.0.0
synopsis:           Selective task DAG workflow orchestrator
description:
    Free Selective Applicative Functor workflow orchestrator over algebraic graph
    DAGs, providing static dependency analysis, virtual tree caching, and hermetic
    subprocess execution under algebraic effects.
    .
    Conceptual Lineage and Attribution:
    This package is an intellectual derivation and architectural synthesis of concepts
    pioneered by:
    * 'porcupine' & 'kernmantle' (Yves Parès, Faura et al.) — pipeline task caching
      and virtual tree sandboxing semantics (superseding arrow notation with Selective)
    * 'funflow' (Tom Nielsen, Andreas Herrmann / Tweag I/O) — functional workflow graphs
    * 'selective' (Andrey Mokhov et al.) — Selective Applicative Functors
    * 'algebraic-graphs' (Andrey Mokhov) — algebraic graph DAG representations
    * 'typed-process' (Michael Snoyman) — safe typed subprocess supervision
    .
    See NOTICE.md at the repository root for complete intellectual provenance,
    conceptual lineage, and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Development, Workflow
build-type:         Simple

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

library
    import:           commons
    exposed-modules:
        Yamaarashi.Flow
        Yamaarashi.Flow.Types
        Yamaarashi.Flow.Scheduler
        Yamaarashi.Flow.Capability
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        bytestring >= 0.12,
        selective >= 0.5,
        algebraic-graphs >= 0.7,
        large-anon,
        sarutahiko-fields,
        sarutahiko-records,
        sarutahiko-effect-signatures,
        yamaarashi
    hs-source-dirs:   src

test-suite yamaarashi-flow-test
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        bytestring >= 0.12,
        algebraic-graphs >= 0.7,
        selective >= 0.5,
        yamaarashi-flow,
        tasty,
        hedgehog,
        tasty-hedgehog

executable yamaarashi-exec
    import:           commons
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        bytestring >= 0.12,
        directory >= 1.3,
        filepath >= 1.4,
        time >= 1.12,
        typed-process >= 0.2.10,
        yamaarashi-flow,
        yamaarashi-spec,
        sarutahiko-effect-signatures,
        utai


