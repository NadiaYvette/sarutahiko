cabal-version:      3.14
name:               spike-handlers-as-records
version:            0.1.0.0
synopsis:           Empirical spike: Handlers-as-Records dynamic dispatch overhead
description:
    Empirical spike measuring dynamic dispatch overhead of extensible record
    handlers versus direct GADT pattern-matching across effectful and polysemy.
    .
    Conceptual Lineage and Attribution:
    Validates the Handlers-as-Records hypothesis over 'large-anon' (Edsko de Vries / Well-Typed),
    'effectful' (Ertugrul Söylemez, Dominik Peteler), and 'polysemy' (Sandy Maguire).
    .
    See NOTICE.md at the repository root for complete intellectual provenance
    and licensing acknowledgments.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Testing, Effects

common commons
    default-language: GHC2024
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints
        -O2

library
    import:           commons
    exposed-modules:  Spike
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        effectful-core,
        polysemy,
        large-anon,
        sarutahiko-records
    hs-source-dirs:   src

benchmark spike-handlers-as-records-bench
    import:           commons
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   bench
    build-depends:
        base >= 4.20 && < 5,
        containers >= 0.6,
        text >= 2.1,
        time >= 1.12,
        effectful-core,
        polysemy,
        large-anon,
        spike-handlers-as-records
